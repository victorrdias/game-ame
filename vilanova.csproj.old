<Project Sdk="Godot.NET.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetFramework)' != '' ">$(GodotTargetFramework)</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Vilanova</RootNamespace>
    <AssemblyName>vilanova</AssemblyName>
  </PropertyGroup>
</Project>
